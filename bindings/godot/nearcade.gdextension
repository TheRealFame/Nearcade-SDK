[configuration]
entry_symbol = "nearcade_godot_init"
compatibility_minimum = 4.6

[libraries]
linux.debug.x86_64 = "res://bin/libnearcade_godot.linux.debug.x86_64.so"
linux.release.x86_64 = "res://bin/libnearcade_godot.linux.release.x86_64.so"
windows.debug.x86_64 = "res://bin/libnearcade_godot.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libnearcade_godot.windows.release.x86_64.dll"
macos.debug = "res://bin/libnearcade_godot.macos.debug.dylib"
macos.release = "res://bin/libnearcade_godot.macos.release.dylib"
